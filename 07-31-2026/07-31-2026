### Extension

You are just giving the default behavior to you protocol method, or to remove the duplicate code


protocol Player() {

func play()

}

extension Player {
func play(){
print("play")
}
}


class Sony: Player {

}

class SonyMax: Player {

}

let s1 = Sony()
s1.play()

let s2 = SonyMax()
s2.play()


