 10  diff b/w assoicated values and raw values

    Enum are of two types, Associated value or rawValue

    Associated:

    enum RestApi{

    case success(Boolean)
    case failure(Boolean)
    
    }

    var success: RestApi = .success(true)
    var failure: RestApi = .failure(false)

    RawValue:

    enum RestApi{
    
    case success = "Success"
    case failure = "Failure"
    
    }

    var _apiSuccess : RestApi = .success
